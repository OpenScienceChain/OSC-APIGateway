JWT_SECRET=mySuperSecureSecret123
JWT_EXPIRES_IN=2h

# Admin user 1
ADMIN1_USERNAME=admin
ADMIN1_PASSWORD=securePassword123
ADMIN1_ROLES=admin

# Admin user 2
ADMIN2_USERNAME=superadmin
ADMIN2_PASSWORD=superSecurePassword456
ADMIN2_ROLES=admin
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# RabbitMQ. Plain AMQP is permitted only for local development.
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_ALLOW_INSECURE_LOCAL=false
OUTBOX_MAX_ATTEMPTS=8

# US-RSE 2026 demonstration. Supply all three secrets from AWS Secrets Manager;
# each must be at least 32 characters and must be distinct from JWT_SECRET.
DEMO_ALLOWED_ORIGIN=https://demo.osc-staging.org
DEMO_JWT_SECRET=replace-with-a-random-demo-session-secret
DEMO_ANALYTICS_HMAC_SECRET=replace-with-a-random-analytics-hmac-secret
DEMO_CONTROL_API_KEY=replace-with-a-random-lifecycle-control-key
GHW_NSG_URL=http://history-worker-nsg:8002
GHW_CITIZEN_SCIENCE_URL=http://history-worker-citizen-science:8002
NSG_ORGANIZATION_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
CITIZEN_SCIENCE_ORGANIZATION_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb

# AWS/Amazon MQ uses AMQPS and certificate validation.
# RABBITMQ_PROTOCOL=amqps
# RABBITMQ_PORT=5671
# RABBITMQ_TLS_SERVERNAME=b-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.mq.us-west-2.amazonaws.com
# RABBITMQ_TLS_CA_PATH=/etc/ssl/certs/osc-rabbitmq-ca.pem
